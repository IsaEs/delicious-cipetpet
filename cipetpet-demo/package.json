{
  "name": "cipetpet-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A spoken conversation with an AI model in the browser: Duyu-small (speech to text) -> an LLM via OpenRouter or any OpenAI-compatible API -> Antalia-2 Mini or EMA Lightning (text to speech).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "cipetpet": "file:../cipetpet",
    "cipetpet-react": "file:../cipetpet-react",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
