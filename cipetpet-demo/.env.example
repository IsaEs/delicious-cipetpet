# Copy to .env.local (gitignored) and fill in. Values in the real environment win over this file.

# The /api/chat proxy talks to OpenRouter, to any OpenAI-compatible API, or to several of them (the page lets you pick).
# Keys stay on the server: the proxy adds them to upstream requests and never sends them to the browser or the log.

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# Model used when the page does not pick one.
OPENROUTER_MODEL=openai/gpt-4o

# Sent to OpenRouter as HTTP-Referer / X-Title (app attribution). Defaults: http://localhost:<PORT>, "cipetpet demo".
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- Any OpenAI-compatible API (OpenAI, Groq, Together, DeepSeek, Mistral, a local Ollama / LM Studio / vLLM ...) ---
# List ids (a-z, 0-9, -, _), then set LLM_<ID>_* for each one (<ID> in capitals, "-" written as "_"):
#   LLM_<ID>_BASE_URL  the API root that has /chat/completions and /models (required)
#   LLM_<ID>_API_KEY   sent as "Authorization: Bearer ..."; leave it empty for a local server without auth
#   LLM_<ID>_MODEL     the model used when the page does not pick one
#   LLM_<ID>_NAME      the name shown in the page (default: the id)
LLM_PROVIDERS=
# Examples:
# LLM_PROVIDERS=openai,ollama
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-...
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_OPENAI_NAME=OpenAI
# LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LLM_OLLAMA_MODEL=llama3.2
# LLM_OLLAMA_NAME=Ollama (local)

# The provider the page uses until someone picks another (default: OpenRouter when it has a key, else the first listed).
LLM_DEFAULT_PROVIDER=

# Local server. HOST stays 127.0.0.1 unless you really want the proxy (and your key) reachable from your network.
PORT=5173
HOST=127.0.0.1

# Names (besides localhost and IP addresses) the server answers to, comma separated. Any other Host header is refused
# (DNS-rebinding protection). Only needed when you serve the demo under a domain name.
ALLOWED_HOSTS=

# OpenRouter's base URL, only for tests (a local mock). Default: https://openrouter.ai/api/v1
OPENROUTER_UPSTREAM=

# Not an env variable but a shell one: DEMO_ENV_FILE=none npm start   starts the server without reading this file.
