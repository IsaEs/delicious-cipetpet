{
  // Browser code (src/). The "paths" mirror the esbuild aliases in scripts/build.mjs: "cipetpet" and
  // "cipetpet-react" resolve to the sibling packages' TypeScript sources, so the demo builds and type-checks
  // before those packages publish a dist/. Once they do, the paths (and the aliases) can be dropped.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "cipetpet": ["../cipetpet/src/index.ts"],
      "cipetpet-react": ["../cipetpet-react/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}
