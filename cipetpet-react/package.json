{
  "name": "cipetpet-react",
  "version": "0.2.0",
  "description": "React hooks and components for cipetpet: Turkish text to speech (Antalia-2 Mini, EMA Lightning) and speech recognition (Duyu-small) in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "keywords": [
    "react",
    "tts",
    "stt",
    "speech",
    "turkish",
    "onnx",
    "cipetpet"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "example": "node example/build.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "cipetpet": "^0.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cipetpet": "file:../cipetpet",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaEs/delicious-cipetpet.git",
    "directory": "cipetpet-react"
  },
  "homepage": "https://github.com/IsaEs/delicious-cipetpet#readme",
  "bugs": {
    "url": "https://github.com/IsaEs/delicious-cipetpet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
